# ============================================================
# face_detection — CUDA Runtime
# Uses nvidia/cuda base + onnxruntime-gpu
# NO PyTorch needed (InsightFace uses ONNX Runtime directly)
# ============================================================

# --- Stage 1: Builder ---
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04 AS builder

# Enable universe repo (libturbojpeg0-dev is in universe, not main)
RUN sed -i 's/Components: main restricted/Components: main restricted universe/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    pkg-config \
    libcairo2-dev \
    libgirepository1.0-dev \
    libturbojpeg0-dev \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# GPU-accelerated ONNX Runtime
RUN pip install --no-cache-dir onnxruntime-gpu

COPY face_detection/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt


# --- Stage 2: Runtime (no compilers, no dev headers) ---
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

# Enable universe repo (libturbojpeg0 is in universe, not main)
RUN sed -i 's/Components: main restricted/Components: main restricted universe/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    libgl1 \
    libglib2.0-0 \
    libturbojpeg0t64 \
    libcairo2 \
    libgirepository-1.0-1 \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
COPY --from=builder $VIRTUAL_ENV $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /app

RUN mkdir -p /app/face_detection/faces

COPY face_detection/ ./face_detection/

ENV PYTHONPATH=/app/face_detection
CMD ["uvicorn", "face_detection.face_detection:app", "--host", "0.0.0.0", "--port", "8003"]
