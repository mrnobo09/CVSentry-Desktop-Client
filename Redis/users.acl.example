# =============================================================================
# Redis ACL File — generated by setup.sh from .env values
# DO NOT edit this file manually; run ./setup.sh to regenerate it.
# =============================================================================

# Disable the built-in 'default' user (no unauthenticated access)
user default off nopass nocommands nokeys

# CVSentry application user — full access
user cvsentry on >change_me_to_a_strong_password ~* &* +@all
